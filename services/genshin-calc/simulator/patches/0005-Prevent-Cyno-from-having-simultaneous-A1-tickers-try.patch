From a7eba94dc32186d8ec07d8f86dd75b33a8edd5ba Mon Sep 17 00:00:00 2001
From: jwalk-511 <jwalk511.genshin@gmail.com>
Date: Fri, 6 Nov 2026 17:06:41 -0600
Subject: [PATCH 5/5] Prevent Cyno from having simultaneous A1 tickers try 2
 (#3266)

* Prevent simultaneous a1 tickers

* Update cyno.go

* Cyno Q overwrites A1 timing

* Fix skill CD mechanics

* Remove outdated comment in skill.go

* Snapshot a1 src on creation instead of callback

(cherry picked from commit ebef6b53e2843e483e3da171d926c9b731c3d70f)
---
 internal/characters/cyno/asc.go | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/internal/characters/cyno/asc.go b/internal/characters/cyno/asc.go
index b3d551120..108e89d06 100644
--- a/internal/characters/cyno/asc.go
+++ b/internal/characters/cyno/asc.go
@@ -37,7 +37,8 @@ func (c *char) a1OnBurst() {
 	if c.Base.Ascension < 1 {
 		return
 	}
-	c.QueueCharTask(func() { c.a1(c.burstSrc) }, 328)
+	src := c.burstSrc
+	c.QueueCharTask(func() { c.a1(src) }, 328)
 }
 
 func (c *char) a1OnSkillRevelation() {
@@ -45,7 +46,8 @@ func (c *char) a1OnSkillRevelation() {
 		return
 	}
 
-	c.QueueCharTask(func() { c.a1(c.burstSrc) }, 265)
+	src := c.burstSrc
+	c.QueueCharTask(func() { c.a1(src) }, 265)
 }
 
 func (c *char) a1Buff() {
-- 
