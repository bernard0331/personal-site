+
+// passive: Radiance on the Water # Weapon_Sword_Fajian
+//
+//	Increases Elemental Mastery by 52 for 12s after Elemental Skill use. Max 2
+//	stacks, and each stack's duration is independent of the others.
+package silverlight
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/keys"
+)
+
+func init() {
+	core.RegisterWeaponFunc(keys.SilverLight, NewWeapon)
+}
